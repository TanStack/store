export interface Input {
  value: () => Record<string, unknown>
  key?: string
  content?: Marko.Body
}

import { publishStore } from './store-bus'

<const/contextKey=input.key ?? '__tanstack_store_context'>

// The content renders under `<if=bundle>` so Marko orders it after this const.
// Since Marko 6.4.7 a client-created branch sets up before the values it
// receives, so rendering the content directly could run a child
// <store-context> before the bundle is on the shelf.
<const/bundle=(() => {
  const g = ($global ?? {}) as unknown as Record<string, unknown>
  const marker = contextKey + '$owner'
  if (g[marker]) {
    throw new Error(
      'Duplicate <store-provider> for context key "' +
        contextKey +
        '". Only one provider per key is supported in Marko; use distinct keys, or share a module-singleton store directly.',
    )
  }
  g[marker] = true
  const value = input.value()
  g[contextKey] = value
  return value
})()>

<lifecycle
  onMount() {
    const g = ($global ?? {}) as unknown as Record<string, unknown>
    g[contextKey] = input.value()
    g[contextKey + '$owner'] = true
    publishStore()
  }
  onDestroy() {
    const g = ($global ?? {}) as unknown as Record<string, unknown>
    g[contextKey] = undefined
    g[contextKey + '$owner'] = undefined
  }
>

<if=bundle>
  <${input.content}/>
</if>
