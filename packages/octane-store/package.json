{
  "name": "@tanstack/octane-store",
  "version": "0.13.1",
  "description": "Framework agnostic type-safe store w/ reactive framework adapters",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TanStack/store.git",
    "directory": "packages/octane-store"
  },
  "homepage": "https://tanstack.com/store",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "store",
    "octane",
    "typescript"
  ],
  "scripts": {
    "clean": "premove ./dist ./coverage",
    "lint": "oxlint ./src ./tests",
    "lint:fix": "oxlint ./src ./tests --fix",
    "test:oxlint": "oxlint ./src ./tests",
    "test:types": "tsc",
    "test:lib": "vitest && vitest --config vitest.ssr.config.ts",
    "test:lib:dev": "vitest --watch",
    "test:build": "publint --strict",
    "build": "tsc -p tsconfig.build.json --noEmit"
  },
  "type": "module",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "dependencies": {
    "@tanstack/store": "workspace:*"
  },
  "devDependencies": {
    "@tsrx/oxc": "0.24.0",
    "octane": "0.23.1",
    "oxlint": "^1.94.0"
  },
  "peerDependencies": {
    "octane": ">=0.12.0"
  }
}
