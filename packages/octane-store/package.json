{
  "name": "@tanstack/octane-store",
  "version": "0.12.2",
  "description": "Framework agnostic type-safe store w/ reactive framework adapters",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TanStack/store.git",
    "directory": "packages/octane-store"
  },
  "homepage": "https://tanstack.com/store",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "store",
    "octane",
    "typescript"
  ],
  "scripts": {
    "clean": "premove ./dist ./coverage",
    "test:eslint": "eslint ./src ./tests",
    "test:types": "pnpm run \"/^test:types:ts[0-9]{2}$/\"",
    "test:types:ts56": "node ../../node_modules/typescript56/lib/tsc.js",
    "test:types:ts57": "node ../../node_modules/typescript57/lib/tsc.js",
    "test:types:ts58": "node ../../node_modules/typescript58/lib/tsc.js",
    "test:types:ts59": "tsc",
    "test:lib": "vitest && vitest --config vitest.ssr.config.ts",
    "test:lib:dev": "vitest --watch",
    "test:build": "publint --strict",
    "build": "tsc -p tsconfig.build.json --noEmit"
  },
  "type": "module",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "dependencies": {
    "@tanstack/store": "workspace:*"
  },
  "devDependencies": {
    "octane": "0.1.21"
  },
  "peerDependencies": {
    "octane": "0.1.21"
  }
}
